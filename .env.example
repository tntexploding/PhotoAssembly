# 密钥只能放在系统环境变量、.env 或 .env.local；不要写入 config.local.json。
OPENAI_API_KEY=
GITHUB_TOKEN=

# 本地服务固定只允许回环地址。
HOST=127.0.0.1
PORT=3000

# 所有相对路径都相对于项目根目录，而不是启动 Shell 的当前目录。
PHOTOASSEMBLY_DATA_DIR=.photoassembly
SKILL_LIBRARY_FILE=.photoassembly/saved-skills.json
CODEX_JOBS_DIR=.photoassembly/jobs
PHOTOASSEMBLY_BACKUPS_DIR=.photoassembly/backups
PHOTOASSEMBLY_LOG_FILE=.photoassembly/logs/app.log
PHOTOASSEMBLY_LOG_LEVEL=info

MAX_IMAGE_BYTES=10485760
MAX_IMAGE_PIXELS=50000000
MAX_IMAGE_DIMENSION=16384
MAX_REQUEST_BYTES=15073280
MAX_RESULT_BYTES=26214400
JOB_RETENTION_DAYS=0

OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_SIZE=auto
OPENAI_IMAGE_QUALITY=medium
OPENAI_IMAGE_OUTPUT_FORMAT=png
OPENAI_IMAGE_INPUT_FIDELITY=high
OPENAI_PROMPT_MAX_CHARS=32000
OPENAI_TIMEOUT_MS=120000
OPENAI_MAX_RETRIES=2

# 使用 * 可允许任意公网 HTTPS 主机；默认建议只开启实际使用的域名。
STYLE_IMPORT_HOSTS=raw.githubusercontent.com,api.github.com
STYLE_IMPORT_TIMEOUT_MS=15000
GITHUB_CACHE_TTL_MS=300000
IMPORTED_SKILLS_ALLOW_TEXT=true
